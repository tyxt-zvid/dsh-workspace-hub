{
  "name": "@local/dsh-workspace-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace-scoped task board shared across sessions, plus main-session-managed sub chats.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "workspace",
    "tasks",
    "subagents"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/core.test.mjs",
    "pack:tarball": "npm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
