{
  "name": "@local/dsh-workspace-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Top-level workspace hub: cross-workspace overview, shared task boards, sessions/sub-chats and dev-server status, with workspace rules/context/skills.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "workspace",
    "tasks",
    "subagents"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "GUIDE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/core.test.mjs && node test/snapshot.test.mjs && node test/overview.test.mjs && node test/client-ui.test.mjs",
    "pack:tarball": "npm pack --pack-destination dist",
    "test:core": "node test/core.test.mjs",
    "test:snapshot": "node test/snapshot.test.mjs",
    "test:client": "node test/client-ui.test.mjs",
    "test:overview": "node test/overview.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyxt-zvid/dsh-workspace-hub.git"
  },
  "homepage": "https://github.com/tyxt-zvid/dsh-workspace-hub#readme",
  "bugs": {
    "url": "https://github.com/tyxt-zvid/dsh-workspace-hub/issues"
  }
}
